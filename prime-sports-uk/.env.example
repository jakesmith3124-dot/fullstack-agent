# Copy to .env.local for local development. Never commit real secrets.

# Public site address (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings → API). Create the project in London (eu-west-2).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys, and the webhook signing secret for /api/stripe/webhook)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local development only: run the booking flow without Stripe. Ignored in production.
PAYMENTS_FAKE=

# Email (Resend). Verify primesportsuk.org in Resend first.
RESEND_API_KEY=
EMAIL_FROM="Prime Sports UK <bookings@primesportsuk.org>"

# Cloudflare Turnstile (spam protection on public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web push for the Prime Camps app. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@primesportsuk.org

# Protects the scheduled jobs (/api/cron/*). Vercel sends it automatically as a Bearer token.
CRON_SECRET=

# Salt for hashing visitor IPs in the rate limiter
RATE_LIMIT_SALT=

# Owner account created by `npm run seed:owner`
OWNER_EMAIL=admin@primesportsuk.org
